<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lambamba Rush Worth - Real GH¢</title>
<style>
:root{--gold:#FFCC00;--black:#0A0A0A}
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui}
body{background:#000;color:#fff;display:flex;justify-content:center;min-height:100vh}
.app{width:100%;max-width:420px;background:#111;border:2px solid var(--gold);border-radius:24px;margin:10px;padding:20px}
h1{color:var(--gold);text-align:center;font-weight:900}
.btn{width:100%;background:var(--gold);color:#000;border:0;padding:16px;border-radius:14px;font-weight:900;font-size:18px;margin-top:12px;cursor:pointer}
.input{width:100%;padding:14px;border-radius:12px;border:1px solid #333;background:#1a1a1a;color:#fff;margin-top:10px}
.card{background:#1c1c1c;padding:14px;border-radius:14px;margin-top:12px;border:1px solid #2a2a2a}
.hidden{display:none}
.small{font-size:12px;opacity:.7;text-align:center;margin-top:8px}
</style>
</head>
<body>
<div class="app">
<h1>LAMBAMBA RUSH WORTH</h1>
<p class="small">MTN MoMo Cashout • Secure Login</p>

<div id="auth">
<h3 style="margin-top:20px">Sign Up / Login</h3>
<input id="name" class="input" placeholder="Full Name">
<input id="phone" class="input" placeholder="MTN Number 024...">
<input id="pass" class="input" type="password" placeholder="Create Password">
<button class="btn" onclick="sendOTP()">Send Verification Code</button>
<div id="otpBox" class="hidden">
<input id="otp" class="input" placeholder="Enter 6-digit code (we sent 123456)">
<button class="btn" onclick="verify()">Verify & Enter Game</button>
<p class="small">Demo code is 123456 for testing</p>
</div>
<p class="small" onclick="toggleLogin()" style="cursor:pointer;color:#FFCC00">Already have account? Login</p>
</div>

<div id="game" class="hidden">
<div class="card"><b>Balance: GH¢ <span id="bal">0.00</span></b><br><small>Coins: <span id="coins">0</span> | Energy: <span id="eng">100</span>%</small></div>
<button class="btn" onclick="tapCoin()">TAP TO EARN +10</button>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px">
<button class="btn" style="background:#222;color:#fff" onclick="deposit()">Deposit Min 20 GH¢</button>
<button class="btn" style="background:#222;color:#fff" onclick="withdraw()">Withdraw Min 100 GH¢</button>
</div>
<div class="card">MTN MoMo Number: <span id="myNum"></span></div>
<button class="btn" style="background:#333;color:#FFCC00" onclick="admin()">Admin Panel</button>
<button class="btn" style="background:transparent;border:1px solid #333;color:#fff" onclick="logout()">Logout</button>
</div>

<div id="admin" class="hidden">
<h3>Admin - Lambambo2026</h3>
<input id="adminPass" class="input" type="password" placeholder="Enter Admin Password">
<button class="btn" onclick="checkAdmin()">Unlock</button>
<div id="adminData" class="hidden card"></div>
<button class="btn" onclick="closeAdmin()">Back</button>
</div>
</div>

<script>
let users=JSON.parse(localStorage.getItem('l_users')||'{}');
let current=null;
function sendOTP(){
 let p=document.getElementById('phone').value,n=document.getElementById('name').value,ps=document.getElementById('pass').value;
 if(!p||!n||!ps){alert('Fill all fields');return}
 if(p.length<10){alert('Enter valid MTN number');return}
 localStorage.setItem('temp_user',JSON.stringify({name:n,phone:p,pass:ps}));
 document.getElementById('otpBox').classList.remove('hidden');
 alert('OTP sent to '+p+' - Code: 123456');
}
function verify(){
 if(document.getElementById('otp').value!=='123456'){alert('Wrong code, use 123456');return}
 let t=JSON.parse(localStorage.getItem('temp_user'));
 if(!users[t.phone]) users[t.phone]={...t,balance:0,coins:0,energy:100,withdrawnToday:0};
 localStorage.setItem('l_users',JSON.stringify(users));
 login(t.phone);
}
function login(phone){ current=users[phone]; localStorage.setItem('l_current',phone); showGame(); }
function showGame(){
 document.getElementById('auth').classList.add('hidden');
 document.getElementById('game').classList.remove('hidden');
 document.getElementById('myNum').innerText=current.phone;
 updateUI();
}
function updateUI(){ document.getElementById('bal').innerText=(current.balance/100).toFixed(2); document.getElementById('coins').innerText=current.coins; document.getElementById('eng').innerText=current.energy; localStorage.setItem('l_users',JSON.stringify(users)); }
function tapCoin(){ if(current.energy<=0){alert('No energy, deposit to recharge');return} current.coins+=10; current.energy-=1; current.balance+=10; updateUI(); }
function deposit(){ let a=prompt('Enter amount Min 20 GH¢'); if(!a||isNaN(a)||a<20){alert('Min is 20 GH¢');return} current.balance+=parseFloat(a)*100; current.energy=100; alert('Deposited GH¢'+a+' via MTN MoMo - Energy refilled'); updateUI(); }
function withdraw(){ if(current.balance/100<100){alert('Min withdrawal is 100 GH¢. You have GH¢'+(current.balance/100).toFixed(2));return} if(current.withdrawnToday>=1){alert('Only 1 withdrawal per day allowed');return} let a=prompt('Withdraw amount (Min 100 GH¢)'); if(a<100){alert('Min 100');return} current.balance-=a*100; current.withdrawnToday=1; alert('Withdrawal of GH¢'+a+' sent to MTN '+current.phone+' - Processing'); updateUI(); }
function logout(){ localStorage.removeItem('l_current'); location.reload(); }
function toggleLogin(){ let p=prompt('Enter your MTN number to login'); if(users[p]) login(p); else alert('Not found, please sign up'); }
function admin(){ document.getElementById('game').classList.add('hidden'); document.getElementById('admin').classList.remove('hidden'); }
function checkAdmin(){ if(document.getElementById('adminPass').value!=='Lambambo2026'){alert('Wrong password');return} let d=document.getElementById('adminData'); d.classList.remove('hidden'); let html='<b>All Users:</b><br><br>'; for(let k in users){ html+=users[k].name+' - '+k+' - Bal: GH¢'+(users[k].balance/100).toFixed(2)+'<br>'; } d.innerHTML=html; }
function closeAdmin(){ document.getElementById('admin').classList.add('hidden'); document.getElementById('game').classList.remove('hidden'); }
window.onload=()=>{ let c=localStorage.getItem('l_current'); if(c&&users[c]){ current=users[c]; showGame(); } }
</script>
</body>
</html>